{
  "name": "openkline",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/core",
    "examples/_shared",
    "examples/core",
    "examples/playground"
  ],
  "scripts": {
    "build": "npm run build -w packages/core",
    "build:examples": "npm run build -w examples/core -w examples/playground",
    "dev:core": "npm run dev -w examples/core",
    "dev:playground": "npm run dev -w examples/playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "./node_modules/typescript-native/bin/tsc --noEmit -p packages/core/tsconfig.json && ./node_modules/typescript-native/bin/tsc --noEmit -p examples/core/tsconfig.json && ./node_modules/typescript-native/bin/tsc --noEmit -p examples/playground/tsconfig.json",
    "lint": "eslint packages examples --max-warnings 0 && npm run lint:react && node tools/react-lint/verify.mjs",
    "lint:fix": "eslint packages examples --fix && npm run lint:react -- --fix",
    "size": "node scripts/size.mjs",
    "docs": "typedoc",
    "postinstall": "npm ci --prefix tools/react-lint",
    "lint:react": "tools/react-lint/node_modules/.bin/eslint --config tools/react-lint/eslint.config.js examples/playground --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.20",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.4",
    "typescript-native": "npm:typescript@~7.0.2"
  }
}
